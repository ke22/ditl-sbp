{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ditl_sbp/schema/issue-package.schema.json",
  "title": "Grounded As-is issue package",
  "type": "object",
  "required": ["schema_version", "artifact_type", "case_id", "scenario_id", "issues"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "issue_package"},
    "case_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "issues": {
      "type": "array",
      "items": {"$ref": "#/definitions/issue"}
    }
  },
  "definitions": {
    "issue": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "impact",
        "claim_state",
        "as_is_element_refs",
        "evidence_refs",
        "uncertainty"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "content-provenance.schema.json#/definitions/issue_id"},
        "statement": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "claim_state": {"$ref": "content-provenance.schema.json#/definitions/issue_claim_state"},
        "as_is_element_refs": {"$ref": "content-provenance.schema.json#/definitions/as_is_element_refs"},
        "evidence_refs": {"$ref": "content-provenance.schema.json#/definitions/evidence_refs"},
        "relation_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "marker_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "uncertainty": {"$ref": "content-provenance.schema.json#/definitions/uncertainty"}
      }
    }
  }
}
