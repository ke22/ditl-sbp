{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ditl_sbp/schema/persona-quadrant-names-draft.schema.json",
  "title": "Persona Matrix quadrant names — AI draft for every requested axis pair",
  "description": "persona-matrix-comparison-first（2026-10-22 研究者裁定）：AI 一次替每一組兩條軸的四格，各起草一個名稱與一句描述；研究者可以改寫。有受訪者的格子依他們的落點命名，沒有受訪者的格子只能依兩端命名。",
  "type": "object",
  "required": ["pairs"],
  "additionalProperties": false,
  "properties": {
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["axis_ids", "quadrants"],
        "additionalProperties": false,
        "properties": {
          "axis_ids": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^AXIS-[0-9]+$"}},
          "quadrants": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["quadrant_id", "name", "description", "basis"],
              "additionalProperties": false,
              "properties": {
                "quadrant_id": {"type": "string", "pattern": "^QUADRANT-[1-4]$"},
                "name": {"type": "string", "minLength": 1, "maxLength": 6, "description": "角色名稱，像「質感避難者」：追求或在意的東西＋角色，以者、族、派、客結尾。"},
                "description": {"type": "string", "minLength": 1, "maxLength": 30, "description": "以「想」「視」「期待」開頭，一句話說這群人想要什麼。"},
                "basis": {"type": "string", "enum": ["members", "poles_only"], "description": "members：依落在這一格的受訪者命名；poles_only：這一格沒有受訪者，只依兩條軸的端點命名。"}
              }
            }
          }
        }
      }
    }
  }
}
