{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ditl_sbp/schema/persona-matrix.schema.json",
  "title": "Persona Matrix — behavioral-variable axes and subject placements",
  "description": "add-persona-matrix：比較受訪者，把他們之間反覆出現的行為差異寫成一組區辨行為變項軸，並把每個可辨識的受訪者放到這些軸上（persona-segmentation-reasoning-contract，2026-10-01：主軸類別是分析材料，不是造軸單位）。軸一定要能追溯到至少一個類別；require-complete-persona-matrix-placements：每個受訪者在每一條軸上都要有一筆落點，沒有證據支持的軸要明示標成「無資料」（no_data），不能用預設值填，也不能省略。",
  "type": "object",
  "required": ["schema_version", "case_id", "axes", "subjects"],
  "additionalProperties": false,
  "properties": {
    "framed_by": {
      "type": "object",
      "additionalProperties": false,
      "description": "persona-matrix-hmw-scope-default：產生這份分群時用的 HMW 範圍指紋（tools/hmw_scope.py）。HMW 是設計相關性的背景，不是證據。舊檔沒有這一欄。",
      "properties": {
        "primary_hmw_selection": {"type": "string", "minLength": 1}
      }
    },
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/axis"
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/subject"
      }
    },
    "concerns": {
      "type": "array",
      "items": {"$ref": "#/definitions/concern"},
      "description": "persona-matrix-comparison-first（2026-10-22 研究者裁定，方法 B）：定軸之前先記下每個共同關切的逐人比較。新生成時由生成驗證要求；舊檔沒有這一欄照常可讀。"
    }
  },
  "definitions": {
    "concern": {
      "type": "object",
      "required": ["id", "question", "grounded_in", "comparisons", "outcome", "outcome_note"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^CONCERN-[0-9]+$"},
        "question": {"type": "string", "minLength": 1, "description": "共同關切，寫成一個問題，例如「用餐者怎麼判斷這一餐值不值得？」"},
        "grounded_in": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CAT-[0-9]+$"}},
        "comparisons": {"type": "array", "items": {"$ref": "#/definitions/comparison"}, "description": "每位談到這個關切的確認受訪者最多一筆。"},
        "unattributed_findings": {
          "type": "array",
          "description": "歸屬不明的群體證據裡看到的判斷方式：只用來發現，不能用來定位任何人。",
          "items": {
            "type": "object",
            "required": ["judgment", "evidence_refs"],
            "additionalProperties": false,
            "properties": {
              "judgment": {"type": "string", "minLength": 1},
              "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E-[0-9]+$"}}
            }
          }
        },
        "outcome": {"type": "string", "enum": ["axis", "coexisting_factors", "situational_only", "service_evaluation", "no_difference", "insufficient"]},
        "outcome_note": {"type": "string", "minLength": 1, "description": "為什麼是這個結論；並存因素要寫出是哪幾個。"},
        "observed_differences": {"type": "string", "minLength": 1, "description": "兩階段生成：第一階段比較之後看到的差異與看不出來的地方。"},
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "description": "兩階段生成：第二階段形成或不形成維度之前的四項檢查。",
          "properties": {
            "measures": {"type": "string"},
            "same_construct": {"type": "string"},
            "coexistence": {"type": "string"},
            "situation": {"type": "string"},
            "counterexamples": {"type": "string"}
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "required": ["subject_id", "judgment", "scope", "evidence_refs"],
      "additionalProperties": false,
      "properties": {
        "subject_id": {"type": "string", "pattern": "^P-[0-9]+$"},
        "judgment": {"type": "string", "minLength": 1, "description": "這個人怎麼判斷：依據、參照點、怎麼取捨。"},
        "condition": {"type": "string", "description": "選填：這個判斷成立的情境。"},
        "reference_point": {"type": "string", "description": "選填：他拿什麼當參照（兩階段生成）。"},
        "limits": {"type": "string", "description": "選填：這個人的資料看不出什麼（兩階段生成）。"},
        "statements": {
          "type": "array",
          "description": "兩階段生成：逐句判斷，各自附證據。",
          "items": {
            "type": "object",
            "required": ["text", "evidence_refs"],
            "additionalProperties": false,
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E-[0-9]+$"}}
            }
          }
        },
        "scope": {"type": "string", "enum": ["across_situations", "in_situation", "unclear"]},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E-[0-9]+$"}}
      }
    },
    "axis": {
      "type": "object",
      "required": ["id", "label", "pole_low", "pole_high", "discriminating_basis", "grounded_in"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AXIS-[0-9]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "pole_low": {
          "type": "string",
          "minLength": 1
        },
        "pole_high": {
          "type": "string",
          "minLength": 1
        },
        "representation": {
          "type": "string",
          "enum": ["continuum", "contrast"],
          "description": "persona-axis-representation（2026-10-01 裁定）：continuum＝同一個構念的程度差異，兩端有高低、中間有意義；contrast＝兩種對照的取向（例如順路整合型／專程安排型），pole_low 與 pole_high 只是兩種取向，沒有高低，mid 代表兩種都出現。新生成時必填；舊檔沒有這一欄一律當 continuum 讀。三類以上的分類不在這一版。"
        },
        "discriminating_basis": {
          "type": "string",
          "minLength": 1,
          "description": "為什麼這是一條能區辨受訪者的軸，不是複述類別定義。"
        },
        "concern_ref": {"type": "string", "pattern": "^CONCERN-[0-9]+$", "description": "persona-matrix-comparison-first：這條軸來自哪個共同關切。"},
        "difference_kind": {"type": "string", "enum": ["across_situations", "in_situation"], "description": "across_situations＝跨情境觀察到的差異；in_situation＝只在特定情境觀察到，是候選，不能當成穩定的個人特質。"},
        "purpose_relevance": {"type": "string", "minLength": 1, "description": "這個差異和研究目的的關係。"},
        "axis_type": {"type": "string", "enum": ["judgment_or_behavior", "need", "experience_condition", "situational_mode", "dominant_orientation"], "description": "兩階段生成：使用者特徵、情境性決策方式或主導取向。"},
        "concern_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CONCERN-[0-9]+$"}, "description": "兩階段生成：這條軸綜合了哪些共同關切。"},
        "gaps": {"type": "string", "minLength": 1, "description": "兩階段生成：反例、混合的人與證據缺口。"},
        "overlap_note": {"type": "string", "minLength": 1, "description": "兩階段生成：和其他候選軸是否重複。"},
        "measures_note": {"type": "string", "minLength": 1, "description": "兩階段生成：為什麼這條軸描述的是使用者，不是服務的表現。"},
        "design_implication": {"type": "string", "minLength": 1, "description": "兩階段生成：兩端的人需要什麼不同的服務支持。"},
        "grounded_in": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CAT-[0-9]+$"
          },
          "description": "這條軸的差異在哪些主軸編碼類別的證據裡看得到——是出處，不是「翻譯自哪個類別」；一條軸可以跨好幾個類別，一個類別也可以不生出任何軸。不能是一條跟任何類別都無關、憑空發明的維度。"
        }
      }
    },
    "subject": {
      "type": "object",
      "required": ["id", "evidence_refs", "placements"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P-[0-9]+$"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^E-[0-9]+$"
          },
          "description": "被判斷為同一個人的證據單元——身分判斷是模型的判斷，不是這份 schema 或程式碼做字串比對決定的。"
        },
        "placements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/placement"
          },
          "description": "這個受訪者在各軸上的落點——每一條軸都要恰好出現一次，不能省略也不能重複（referential-integrity 層級的完整性檢查在 stages.py 的 _persona_matrix_errors，schema 本身管不到「跟 axes 陣列比對」這件事）。沒有證據支持的軸要放一筆 position 為 no_data 的落點，不能省略，也不能用 mid 當預設值填滿。"
        }
      }
    },
    "placement": {
      "type": "object",
      "required": ["axis_id", "position", "rationale"],
      "additionalProperties": false,
      "properties": {
        "axis_id": {
          "type": "string",
          "pattern": "^AXIS-[0-9]+$"
        },
        "position": {
          "type": "string",
          "enum": ["near_low", "mid", "near_high", "no_data"]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^E-[0-9]+$"},
          "description": "persona-segmentation-reasoning-contract（2026-10-01）：撐住這個真實落點的證據 id，只能是這個受訪者自己的證據；no_data 不列。新生成時真實落點必填（由生成驗證檢查），舊檔沒有這一欄照舊可讀。落點理由是給研究者讀的文字，證據 id 只放在這裡。"
        },
        "unplaced_reason": {"type": "string", "enum": ["insufficient_evidence", "poles_do_not_fit", "mixed", "situation_dependent"], "description": "persona-matrix-comparison-first：no_data 的原因——證據不足／兩極表達不了他的判斷／兩端都有／看情境。新生成時必填；舊檔沒有這一欄照常可讀。"},
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "position 是真實落點時：根據這個受訪者的哪些證據，判斷他落在這個位置——不能是空字串或只重複軸的定義。position 是 no_data 時：查過哪些證據、為什麼判斷這條軸對這個受訪者沒有資料——不能是空字串，也不能只複述軸的定義。"
        }
      }
    }
  }
}
