{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "selective-themes.schema.json",
  "title": "Selective themes",
  "description": "A run's Selective Coding (selective_themes.yaml, 2026-10-03): core and secondary themes with provenance to axial themes, open codes and evidence; framed by the axial coding and the research purpose. Re-forming writes a new document and archives the previous one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "research_purpose",
    "themes",
    "framed_by",
    "formed_at",
    "researcher_edits"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "research_purpose": {
      "type": "string",
      "minLength": 1
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/theme"
      }
    },
    "framed_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axial_coding",
        "research_purpose"
      ],
      "properties": {
        "axial_coding": {
          "type": "string",
          "minLength": 1
        },
        "research_purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "formed_at": {
      "type": "string",
      "minLength": 1
    },
    "researcher_edits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "theme_id",
          "field",
          "ai_text",
          "researcher_text",
          "edited_at"
        ],
        "properties": {
          "theme_id": {
            "type": "string"
          },
          "field": {
            "enum": [
              "name",
              "core_sentence",
              "insight",
              "key_insights"
            ]
          },
          "ai_text": {},
          "researcher_text": {},
          "edited_at": {
            "type": "string"
          }
        }
      }
    },
    "supersedes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "history_file"
      ],
      "properties": {
        "digest": {
          "type": "string"
        },
        "history_file": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tier",
        "name",
        "core_sentence",
        "insight",
        "axial_refs",
        "concept_refs",
        "key_insights"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": [
            "core",
            "secondary"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "core_sentence": {
          "type": "string",
          "minLength": 1
        },
        "insight": {
          "type": "string",
          "minLength": 1
        },
        "axial_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "concept_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "representative_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "key_insights": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "representative_quote_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^OC-[0-9]+$"
          },
          "description": "converge-coding-contracts（2026-10-03）：代表語句——從這個主題 concept_refs 裡挑出的開放編碼，原樣顯示它們的整理後引言；優先 3–5 則、不同受訪者，不湊數。開放編碼帶引言時必填，取代 representative_evidence_refs。"
        },
        "support_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "coding-support-summary（2026-10-05）：支持摘要——1–3 句、150 字以內，整理多筆資料共同呈現的具體情況；不新增資料沒有支持的心理、原因或因果。新產出必填；舊檔沒有照樣有效。"
        }
      }
    }
  }
}
