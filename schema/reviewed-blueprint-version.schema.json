{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ditl_sbp/schema/reviewed-blueprint-version.schema.json",
  "title": "Reviewed blueprint version",
  "type": "object",
  "required": ["schema_version", "id", "name", "source_run", "created_at", "state", "journey_digest", "artifact_digest", "files"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "source_run": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "minLength": 1}, "state": {"enum": ["saved", "reviewed"]},
    "journey_digest": {"type": "string", "minLength": 1}, "artifact_digest": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}, "reviewer": {"type": "string"},
    "files": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["name", "sha256"], "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64}}}}
  }
}
