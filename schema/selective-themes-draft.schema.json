{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "selective-themes-draft.schema.json",
  "title": "Selective themes draft",
  "description": "The model's Selective Coding output: core and secondary selective themes formed from the run's axial themes in relation to the research purpose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "themes"
  ],
  "properties": {
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/theme"
      }
    },
    "purpose_report": {
      "description": "purpose-aware-research-calibration: one item per concern the researcher names in the project or research purpose, quoted verbatim as focus, reporting where it appears and why it is not core; absent when both purposes are empty. Never changes the tiers.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/purpose_report_item"
      }
    }
  },
  "definitions": {
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tier",
        "name",
        "core_sentence",
        "insight",
        "axial_refs",
        "concept_refs",
        "key_insights"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": [
            "core",
            "secondary"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "core_sentence": {
          "type": "string",
          "minLength": 1
        },
        "insight": {
          "type": "string",
          "minLength": 1
        },
        "axial_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "concept_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "representative_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "key_insights": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "representative_quote_refs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^OC-[0-9]+$"
          },
          "description": "converge-coding-contracts（2026-10-03）：代表語句——從這個主題 concept_refs 裡挑出的開放編碼，原樣顯示它們的整理後引言；優先 3–5 則、不同受訪者，不湊數。開放編碼帶引言時必填，取代 representative_evidence_refs。"
        },
        "support_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "coding-support-summary（2026-10-05）：支持摘要——1–3 句、150 字以內，整理多筆資料共同呈現的具體情況；不新增資料沒有支持的心理、原因或因果。新產出必填；舊檔沒有照樣有效。"
        }
      }
    },
    "purpose_report_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focus",
        "found_in_layers",
        "why_not_core",
        "related_axial_refs"
      ],
      "properties": {
        "focus": {
          "description": "The concern as the researcher wrote it: a phrase copied verbatim from the project or research purpose.",
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "found_in_layers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open",
            "axial",
            "selective"
          ],
          "properties": {
            "open": {
              "type": "boolean"
            },
            "axial": {
              "type": "boolean"
            },
            "selective": {
              "type": "boolean"
            }
          }
        },
        "why_not_core": {
          "type": "string",
          "maxLength": 120
        },
        "related_axial_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
