{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ditl_sbp/schema/journey-solutions.schema.json",
  "title": "Solutions developed for researcher-selected Journey moments",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "moments"],
  "properties": {
    "schema_version": {"const": 1},
    "moments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/moment"}
    }
  },
  "definitions": {
    "moment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "analysis", "solution"],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "analysis": {"$ref": "journey.schema.json#/definitions/solution_analysis"},
        "solution": {
          "description": "這一刻的一個主要解方；它的具體介入寫在各管道底下。",
          "$ref": "#/definitions/solution"
        }
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_refs", "basis", "delivery"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "description": "一句具體做法（50 字以內）：做什麼、在哪裡、做到什麼程度；回應選定的 HMW，但不加「讓⋯能⋯」的結果尾句。誰來做與分工寫在 delivery。只在句尾一個句號。"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "basis": {"enum": ["evidence", "inference"]},
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "people": {"$ref": "#/definitions/channel_roles"},
            "physical_environment": {"$ref": "#/definitions/channel_roles"},
            "digital_tools": {"$ref": "#/definitions/channel_roles"},
            "digital_environments": {"$ref": "#/definitions/channel_roles"}
          }
        }
      }
    },
    "channel_roles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/channel_role"}
    },
    "channel_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "basis"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "basis": {"enum": ["evidence", "inference"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "if": {"properties": {"basis": {"const": "evidence"}}},
      "then": {"required": ["evidence_refs"], "properties": {"evidence_refs": {"minItems": 1}}}
    }
  }
}
