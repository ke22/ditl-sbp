{
  "$schema": "http://json-schema.org/draft-07/schema#", "$id": "ditl_sbp/schema/reference-hypotheses.schema.json", "title": "Non-normative reference hypotheses", "type": "object", "required": ["meta", "expectations"], "additionalProperties": false,
  "properties": {"meta": {"type": "object", "required": ["case_id"], "properties": {"case_id": {"type": "string"}}, "additionalProperties": true}, "expectations": {"type": "array", "items": {"$ref": "#/definitions/expectation"}}},
  "definitions": {"layer": {"enum": ["實體證據", "顧客行動", "前台行動", "後台行動", "支援流程"]}, "expectation": {"type": "object", "required": ["id", "label", "step", "layer", "basis", "rationale", "validation_question"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^X-[A-Za-z0-9_-]+$"}, "label": {"type": "string", "minLength": 1}, "step": {"type": "integer", "minimum": 1}, "layer": {"$ref": "#/definitions/layer"}, "basis": {"const": "model_prior"}, "rationale": {"type": "string", "minLength": 1}, "validation_question": {"type": "string", "minLength": 1}, "status": {"enum": ["supported", "partially_supported", "unsupported", "contradicted", "out_of_scope"]}, "matched_node_refs": {"type": "array", "items": {"type": "string", "pattern": "^(A|P)-"}}, "conflict_refs": {"type": "array", "items": {"type": "string"}}, "ask_roles": {"type": "array", "items": {"type": "string", "minLength": 1}}, "unresolved_dimension": {"type": "string"}}, "allOf": [{"if": {"required": ["status"], "properties": {"status": {"enum": ["supported", "partially_supported"]}}}, "then": {"required": ["matched_node_refs"]}}, {"if": {"required": ["status"], "properties": {"status": {"const": "unsupported"}}}, "then": {"required": ["ask_roles", "validation_question"], "properties": {"ask_roles": {"minItems": 1}}}}, {"if": {"required": ["status"], "properties": {"status": {"const": "contradicted"}}}, "then": {"anyOf": [{"required": ["matched_node_refs"]}, {"required": ["conflict_refs"]}]}}]}}}
