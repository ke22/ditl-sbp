{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ditl_sbp/schema/narrative-job-candidates.schema.json",
  "title": "JTBD candidates",
  "description": "顧客任務候選。2026-10-03 起（multi-jtbd-single-job-source）由選擇編碼形成，1–8 則、沒有目標數量、不帶 narrative，記 selective_refs 與 framed_by；證據撐不起任何一則時記 insufficient_evidence。各則地位相同、不排序、不推薦。舊檔（三則、帶 narrative、grounded_in 必填）照舊可讀。",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "candidates"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "$ref": "#/definitions/candidate"
      }
    },
    "framed_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selective_themes"
      ],
      "properties": {
        "selective_themes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "insufficient_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "definitions": {
    "candidate": {
      "type": "object",
      "required": [
        "rationale",
        "situation",
        "progress",
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "選這一組，後面的研究會往哪個方向走——研究者沒讀過核心現象，理由要自己講得通，不能只是複述核心現象或四格本身。"
        },
        "narrative": {
          "type": "string",
          "minLength": 80,
          "maxLength": 200,
          "description": "只出現在 2026-10-03 之前的舊候選檔（當時的隱藏核心現象）；新產出不帶，選擇編碼是唯一的綜合層。"
        },
        "situation": {
          "type": "string",
          "minLength": 1,
          "description": "什麼處境下，這件事會被觸發。"
        },
        "progress": {
          "type": "string",
          "minLength": 1,
          "description": "這個人想完成什麼——不指名任何具體服務、技術或產品。"
        },
        "motivation": {
          "type": "string",
          "minLength": 1,
          "description": "為什麼這件事對他重要——他正在面對或在意的事。2026-09-29 研究者裁定站②的 JTBD 改成情境→任務→動機→結果四段；新產出一律要有，舊檔可以沒有這一欄（讀舊檔時不補、不推）。"
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "description": "他怎麼判斷這件事算做到了。"
        },
        "grounded_in": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CAT-[0-9]+$"
          },
          "description": "支持這則的主軸主題（選填；舊檔必有）。"
        },
        "selective_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ST-[0-9]+$"
          },
          "description": "這則顧客任務依據的選擇編碼主題（新產出必填）。"
        }
      }
    }
  }
}
