{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "narrative-job-candidates-draft.schema.json",
  "title": "JTBD candidates draft",
  "description": "模型的顧客任務候選輸出：由選擇編碼形成、證據撐得起、彼此可區辨的顧客任務，1–8 則，不為湊數拆分；證據撐不起任何一則時 candidates 為空並寫 insufficient_evidence。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidates"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "$ref": "#/definitions/candidate"
      }
    },
    "insufficient_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "definitions": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rationale",
        "situation",
        "progress",
        "motivation",
        "outcome",
        "selective_refs"
      ],
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "選這一組，後面的研究會往哪個方向走——研究者沒讀過核心現象，理由要自己講得通，不能只是複述核心現象或四格本身。"
        },
        "situation": {
          "type": "string",
          "minLength": 1,
          "description": "什麼處境下，這件事會被觸發。"
        },
        "progress": {
          "type": "string",
          "minLength": 1,
          "description": "這個人想完成什麼——不指名任何具體服務、技術或產品。"
        },
        "motivation": {
          "type": "string",
          "minLength": 1,
          "description": "為什麼這件事對他重要——他正在面對或在意的事。2026-09-29 研究者裁定站②的 JTBD 改成情境→任務→動機→結果四段；新產出一律要有，舊檔可以沒有這一欄（讀舊檔時不補、不推）。"
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "description": "他怎麼判斷這件事算做到了。"
        },
        "selective_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ST-[0-9]+$"
          },
          "description": "這則顧客任務依據的選擇編碼主題（新產出必填）。"
        },
        "grounded_in": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CAT-[0-9]+$"
          },
          "description": "支持這則的主軸主題（選填；舊檔必有）。"
        }
      }
    }
  }
}