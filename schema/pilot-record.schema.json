{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ditl_sbp/schema/pilot-record.schema.json",
  "title": "Canonical To-be pilot record",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "case_id",
    "scenario_id",
    "pilot_cycle_id",
    "source_to_be_version_ref",
    "source_to_be_fingerprint",
    "state",
    "protocol",
    "actual_scope",
    "observations",
    "not_observed",
    "deviations",
    "adverse_effects",
    "started_by",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "pilot_record"},
    "case_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "pilot_cycle_id": {"$ref": "content-provenance.schema.json#/definitions/pilot_cycle_id"},
    "source_to_be_version_ref": {"$ref": "artifact-lifecycle.schema.json#/definitions/version_id"},
    "source_to_be_fingerprint": {"$ref": "artifact-lifecycle.schema.json#/definitions/digest"},
    "state": {"enum": ["collecting", "completed"]},
    "protocol": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/protocol_entry"}
    },
    "actual_scope": {"type": "string", "minLength": 1},
    "scope_deviation": {"type": "string", "minLength": 1},
    "observations": {
      "type": "array",
      "items": {"$ref": "#/definitions/observation"}
    },
    "not_observed": {
      "type": "array",
      "items": {"$ref": "#/definitions/not_observed"}
    },
    "deviations": {
      "type": "array",
      "items": {"$ref": "#/definitions/pilot_event"}
    },
    "adverse_effects": {
      "type": "array",
      "items": {"$ref": "#/definitions/pilot_event"}
    },
    "started_by": {"$ref": "#/definitions/actor"},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"required": ["state"], "properties": {"state": {"const": "collecting"}}},
      "then": {"not": {"required": ["completed_at"]}}
    },
    {
      "if": {"required": ["state"], "properties": {"state": {"const": "completed"}}},
      "then": {"required": ["completed_at"]}
    }
  ],
  "definitions": {
    "protocol_entry": {
      "type": "object",
      "required": [
        "proposal_ref",
        "target_outcome",
        "metric",
        "method",
        "success_condition",
        "decision_rule",
        "planned_pilot_scope"
      ],
      "additionalProperties": false,
      "properties": {
        "proposal_ref": {"$ref": "content-provenance.schema.json#/definitions/proposal_id"},
        "target_outcome": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "success_condition": {"type": "string", "minLength": 1},
        "decision_rule": {"type": "string", "minLength": 1},
        "planned_pilot_scope": {"type": "string", "minLength": 1}
      }
    },
    "actor": {
      "type": "object",
      "required": ["actor_id", "actor_type", "display_name"],
      "additionalProperties": false,
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "actor_type": {"enum": ["researcher", "operator"]},
        "display_name": {"type": "string", "minLength": 1}
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "id",
        "proposal_ref",
        "subject",
        "collected_at",
        "value_type",
        "value",
        "method",
        "source_kind",
        "source_locator",
        "actor"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "content-provenance.schema.json#/definitions/observation_id"},
        "proposal_ref": {"$ref": "content-provenance.schema.json#/definitions/proposal_id"},
        "subject": {"enum": ["metric", "risk"]},
        "collected_at": {"type": "string", "minLength": 1},
        "value_type": {"enum": ["quantitative", "qualitative", "binary"]},
        "value": {},
        "unit": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "source_kind": {
          "enum": ["case_file", "instrument_record", "field_note", "interview_note", "manual_record"]
        },
        "source_locator": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1},
        "actor": {"$ref": "#/definitions/actor"}
      },
      "allOf": [
        {
          "if": {
            "required": ["value_type"],
            "properties": {"value_type": {"const": "quantitative"}}
          },
          "then": {
            "properties": {"value": {"type": "number"}},
            "required": ["unit"]
          }
        },
        {
          "if": {
            "required": ["value_type"],
            "properties": {"value_type": {"const": "qualitative"}}
          },
          "then": {
            "properties": {"value": {"type": "string", "minLength": 1}},
            "not": {"required": ["unit"]}
          }
        },
        {
          "if": {
            "required": ["value_type"],
            "properties": {"value_type": {"const": "binary"}}
          },
          "then": {
            "properties": {"value": {"type": "boolean"}},
            "not": {"required": ["unit"]}
          }
        }
      ]
    },
    "not_observed": {
      "type": "object",
      "required": ["proposal_ref", "reason", "explanation"],
      "additionalProperties": false,
      "properties": {
        "proposal_ref": {"$ref": "content-provenance.schema.json#/definitions/proposal_id"},
        "reason": {
          "enum": ["not_collected", "method_failed", "scope_changed", "participant_unavailable"]
        },
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "pilot_event": {
      "type": "object",
      "required": ["id", "occurred_at", "source_locator", "explanation"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^(D|AE)-[A-Za-z0-9_-]+$"},
        "occurred_at": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1}
      }
    }
  }
}
