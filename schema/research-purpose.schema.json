{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "research-purpose.schema.json",
  "title": "Research purpose",
  "description": "One researcher-written line stating the research purpose Selective Coding synthesises against (2026-10-03 ruling). Never generated by AI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "text", "source", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "text": {"type": "string", "minLength": 1, "maxLength": 120},
    "source": {"const": "researcher"},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
