{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semantic-segments-draft.schema.json",
  "title": "Semantic segments (model output, one transcript)",
  "description": "open-coding-on-semantic-segments：模型只回傳每段的行號範圍與分析用的判斷；段落原文由程式依行號從逐字稿原樣切出，模型不寫原文。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "segments"
  ],
  "properties": {
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/segment"
      }
    }
  },
  "definitions": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_line",
        "end_line",
        "summary",
        "question_lines",
        "role",
        "in_scope",
        "evidence_refs"
      ],
      "properties": {
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "這一段在談什麼，一百字以內。分析用的閱讀輔助，不是證據。"
        },
        "question_lines": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "這一段裡屬於訪員問題或提示的行號。分析用的判斷，不是證據。"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "description": "這一段的受訪者角色。"
        },
        "in_scope": {
          "type": "boolean"
        },
        "out_of_scope_reason": {
          "type": "string",
          "minLength": 1,
          "description": "不在分析範圍時的原因（開場、同意受訪、道謝等）。"
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^E-[0-9]+$"
          },
          "description": "這一段包含的證據單位。"
        }
      }
    }
  }
}
